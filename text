import cv2

cap = cv2.VideoCapture(0)  # 0 = default webcam
while True:
    ret, frame = cap.read()
    cv2.imshow("Webcam Feed", frame)
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break
cap.release()
cv2.destroyAllWindows()

import mysql.connector

